	<input>
		<keyboard>
			
			<key n="82">
				<name>R</name>
				<desc>Toggle rotor brake</desc>
				<binding>
					<command>nasal</command>
					<script>
						var p = "/controls/rotor/brake";
						setprop(p, !getprop(p));
					</script>
				</binding>
			</key>

			<key n="83">
				<name>S</name>
				<desc>Start display smoke</desc>
				<binding>
					<command>property-toggle</command>
					<!-- controls/smoke -->
					<property>sim/multiplay/generic/int[9]</property>
					</binding>
			</key>
			
			<key n="105">
				<name>i</name>
				<desc>Toggle ignition switch</desc>
				<binding>
					<command>nasal</command>
					<script>
						foreach (var e; controls.engines) {
							if (e.selected.getValue()) {
								var i = e.controls.getNode("ignition", 1);
								i.setValue(!i.getValue());
							}
						}
					</script>
				</binding>
			</key>

			

			<!--<key n="118">
				<name>Alt-v</name>
