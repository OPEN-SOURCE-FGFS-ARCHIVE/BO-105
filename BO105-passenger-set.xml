<!--
  Usage: fgfs - -prop:/sim/remote/pilot-callsign="remote pilot callsign" - -aircraft=Fi-156-passenger
-->
<PropertyList>

 <sim>

  <description>Eurocopter Bo105 Multiplayer passenger</description>
  <author>Anders Gidenstam</author>
  <status>alpha</status>
  <aircraft-version>$Id$</aircraft-version>
  
  <flight-model>null</flight-model>


  <presets>
   <onground type="bool">false</onground>
   <altitude-agl-ft type="double">30.0</altitude-agl-ft>
  </presets>
  
  
  <previews>
	  <preview>
		<type>interior</type>
		<splash type="bool">true</splash>
		<path>Splash/splash0.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/splash1.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/splash2.png</path>
	  </preview>
	  <preview>
		<type>interior</type>
		<splash type="bool">true</splash>
		<path>Splash/splash3.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/splash4.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/splash5.png</path>
	  </preview>
	   <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/fgfs-20240227205228.png</path>
	  </preview>

	</previews>

  <!-- 3d model -->
  <model>
   <path>Aircraft/BO-105/Models/BO105-Passenger.xml</path>
  </model>
  
  	<rendering>
    <refl_correction type="string">-0.2</refl_correction>
	<fresnel-factor>0.7</fresnel-factor>
    </rendering>
  
   		<systems>
   <electrical>
        <path>Aircraft/BO-105/Systems/fgukelectrical.xml</path>
      </electrical>
	  
	    <autopilot n="101">
        <path>Aircraft/BO-105/Systems/glass-rain.xml</path>
        </autopilot>
	 	  

    </systems> 
	
	
	<hud>
   <path n="1">Aircraft/BO-105/Hud/hud.xml</path>
   <visibility n="1">true</visibility>
   
   <palette>
    <color n="0">
     <alpha type="float">0.85</alpha>
     <antialiased type="bool">true</antialiased>
     <brightness type="float">0.85</brightness>
     <transparent type="bool">true</transparent>
     <red type="float">0.38</red>
     <green type="float">0.38</green>
     <blue type="float">0.22</blue>
    </color>
    
   </palette>
   
  </hud>
	
	
	

   <!-- Views -->
  <view n="0">
   <!-- Passenger's position. -->
   <name>Copilot View</name>
   <type>lookfrom</type>
   <config>
    <internal type="bool">true</internal>
    <from-model type="bool">false</from-model>
    <from-model-idx type="int">0</from-model-idx>
    <eye-lat-deg-path>/position/latitude-deg</eye-lat-deg-path>
    <eye-lon-deg-path>/position/longitude-deg</eye-lon-deg-path>
    <eye-alt-ft-path>/position/altitude-ft</eye-alt-ft-path>
    <eye-heading-deg-path>/orientation/heading-deg</eye-heading-deg-path>
    <eye-pitch-deg-path>/orientation/pitch-deg</eye-pitch-deg-path>
    <eye-roll-deg-path>/orientation/roll-deg</eye-roll-deg-path>

    <!-- x/y/z == right/up/back -->
 <x-offset-m archive="y">-0.365</x-offset-m><!--right-->
				<y-offset-m archive="y">0.48</y-offset-m><!--up-->
				<z-offset-m archive="y">0.89</z-offset-m><!--back-->
				<pitch-offset-deg>-14</pitch-offset-deg>
   </config>
  </view>
  <!-- Views -->
 <view n="101">
			<name>Passenger</name>
			<type>lookfrom</type>
			<internal type="bool">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<ground-level-nearplane-m type="double">2f</ground-level-nearplane-m>
				<x-offset-m type="double">0.0</x-offset-m>
				<y-offset-m type="double">0.67</y-offset-m>
				<z-offset-m type="double">2.2</z-offset-m>
				<pitch-offset-deg>-10</pitch-offset-deg>
				<default-field-of-view-deg type="double">55</default-field-of-view-deg>
			</config>
		</view>

	
		
		  <view n="102">
			<name>Winch Cam</name>
			<type>lookfrom</type>
			<internal type="bool">false</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m type="double">-1.35</x-offset-m>
				<y-offset-m type="double">0.67</y-offset-m>
				<z-offset-m type="double">2.4</z-offset-m>
				<pitch-offset-deg>-89</pitch-offset-deg>
				<heading-offset-deg>45</heading-offset-deg>
				<default-field-of-view-deg>85</default-field-of-view-deg>
			</config>
			
		 </view>
		 
		  <view n="103">
    <name>Pilot cam</name>
       <type>lookfrom</type>
			<internal type="bool">true</internal>
        <config>
		 <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
         <x-offset-m type="double">0</x-offset-m>
				<y-offset-m type="double">0.67</y-offset-m>
				<z-offset-m type="double">0.6</z-offset-m>
          <pitch-offset-deg>-20</pitch-offset-deg>
		  <heading-offset-deg>199</heading-offset-deg>
          <default-field-of-view-deg>110</default-field-of-view-deg>
        </config>
		  </view>
		
		
		<view n="104">
			<name>FLIR</name>
			<internal archive="y">false</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m archive="y">-1.0</x-offset-m><!--right-->
				<y-offset-m archive="y">-0.8</y-offset-m><!--up-->
				<z-offset-m archive="y">0.05</z-offset-m><!--back-->
				<pitch-offset-deg>0</pitch-offset-deg>
				<heading-offset-deg>0</heading-offset-deg>
				<default-field-of-view-deg>65</default-field-of-view-deg>
			<limits>
					<enabled type="bool">true</enabled>
					<left>
						<heading-max-deg type="double">160</heading-max-deg>
						<x-offset-max-m type="double">0.20</x-offset-max-m>
						<x-offset-threshold-deg type="double">25</x-offset-threshold-deg>
					</left>
					<right>
						<heading-max-deg type="double">110</heading-max-deg>
						<x-offset-max-m type="double">0.20</x-offset-max-m>
						<x-offset-threshold-deg type="double">25</x-offset-threshold-deg>
					</right>
					</limits>
			</config>
	    <flir type="bool">true</flir>

		</view>
		
		 <view n="105">
    <name>Overhead panel</name>
       <type>lookfrom</type>
			<internal type="bool">true</internal>
        <config>
		 <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
         <x-offset-m archive="y">0.0</x-offset-m><!--right-->
				<y-offset-m archive="y">0.5</y-offset-m><!--up-->
				<z-offset-m archive="y">1.5</z-offset-m><!--back-->
				<pitch-offset-deg>90</pitch-offset-deg>
          <default-field-of-view-deg>110</default-field-of-view-deg>
        </config>
		  </view>
		 
 <view n="1">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
			</config>
		</view>

		<view n="2">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
			</config>
		</view>

		<view n="3">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
			</config>
		</view>

		<view n="4">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
			</config>
		</view>

		<view n="5">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
			</config>
		</view>

		<view n="6">
			<config>
				<target-z-offset-m archive="y" type="double">2.5</target-z-offset-m>
			</config>
		</view>


  <chase-distance-m type="double">-18.0</chase-distance-m>

 	<sound>
			<path>Aircraft/BO-105/Sounds/sound.xml</path>
		</sound>
<weight n="0">
<name>notused</name>
<weight-lb>0</weight-lb>
<selected>none</selected>
<opt>
<name>none</name>
<lbs>0</lbs>
</opt>
 </weight>
 
 <flir>
			<view type="int">104</view>
			<weight type="int">0</weight>
			<options>
				<name>notused</name>
				
			</options>
		</flir>
 
 
 
 <menubar>
   <default>
    <menu n="100">
     <label>EC-145</label>
     <item>
      <label>Select MP-pilot</label>
      <binding>
       <command>nasal</command>
       <script>
        dual_control_tools.
          copilot_dialog.show(aircraft_dual_control.pilot_type);
       </script>
      </binding>
     </item>
    </menu>
   </default>
  </menubar>

 </sim>
 
 	<environment>
    
<precipitation-control>
            <clip-distance type="double">3.75</clip-distance>
        </precipitation-control>
  </environment>
 
 
	<instrumentation>
		<gsdi>
			<serviceable type="bool">true</serviceable>
			<enabled type="bool">true</enabled>
		</gsdi>
	</instrumentation>
 


  <nasal>
  
 
  
  <dual_control_tools>
   <file>Aircraft/Generic/DualControl/dual-control-tools.nas</file>
  </dual_control_tools>
  <aircraft_dual_control>
   <file>Aircraft/BO-105/Nasal/105-dual-control.nas</file>
  </aircraft_dual_control>
  <dual_control>
   <file>Aircraft/Generic/DualControl/copilot-dual-control.nas</file>
  </dual_control>
<bo105>
			<file>Aircraft/BO-105/Models/bo105.nas</file>
			<file>Aircraft/BO-105/Nasal/engines.nas</file>
			<file>Aircraft/Instruments-3d/ki266/ki266.nas</file>
			<file>Aircraft/BO-105/Nasal/liveries.nas</file>
		</bo105>
		
		<flir>
			<file>Aircraft/BO-105/Nasal/flir.nas</file>
		</flir>	
		
		<kns80>
           <file>Aircraft/BO-105/Instruments/kns80/KNS80.nas</file>
        </kns80>
		
			<sound-helper>
      <file>Aircraft/BO-105/Nasal/sound-helper.nas</file>
    </sound-helper> 

 </nasal>

</PropertyList>