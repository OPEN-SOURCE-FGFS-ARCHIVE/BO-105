<?xml version="1.0"?>

<PropertyList>
	
	
<animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>1000</max-m>
    </animation>

<model>
		<name>Pylons</name>
		<path>Aircraft/BO-105/Models/payload/pylons.xml</path>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
			<pitch-deg>0.0</pitch-deg>
		</offsets>
	</model>	


<!-- passenger -->



  <model>
		<name>Passenger</name>
		<path>Aircraft/BO-105/Models/payload/passenger.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Passenger</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Passenger</value>
        </equals>
       
    </condition>
  </animation>	


 
  <model>
		<name>SAR</name>
		<path>Aircraft/BO-105/Models/payload/sar.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>SAR</object-name>      
    <condition>
   
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>SAR</value>
        </equals>
     
    </condition>
  </animation>


 <model>
		<name>Law Enforcement</name>
		<path>Aircraft/BO-105/Models/payload/law.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Law Enforcement</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Law Enforcement</value>
        </equals>
       
    </condition>
  </animation>

  
 <model>
		<name>Medivac</name>
		<path>Aircraft/BO-105/Models/payload/medivac.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m> 0 </y-m>
            <z-m>0</z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Medivac</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Medivac</value>
        </equals>
       
    </condition>
  </animation>

    <model>
		<name>Military_Transport</name>
		<path>Aircraft/BO-105/Models/payload/mil.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Military_Transport</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Military_Transport</value>
        </equals>
       
    </condition>
  </animation>

  <model>
		<name>Mini_Guns</name>
		<path>Aircraft/BO-105/Models/payload/guns.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Mini_Guns</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Mini_Guns</value>
        </equals>
       
    </condition>
  </animation>
  

   <model>
		<name>Anti_Tank</name>
		<path>Aircraft/BO-105/Models/payload/at.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>0</y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Anti_Tank</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Anti_Tank</value>
        </equals>
       
    </condition>
  </animation>


  <animation>
  <type>select</type>
  <object-name>pylon.C</object-name>  
  <condition>
  <or>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Law Enforcement</value>
   </equals>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Medivac</value>
   </equals>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>SAR</value>
   </equals>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Passenger</value>
   </equals>
  
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Military_Transport</value>
   </equals>
   
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Mini_Guns</value>
   </equals>
   
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Anti_Tank</value>
   </equals>
   
  </or>
  </condition>
 </animation>

</PropertyList>
