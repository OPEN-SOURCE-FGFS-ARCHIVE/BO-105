<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

	<path>blade1.ac</path>

	

 <!--  REMBRANDT support for transparent objects-->
    <effect>
        <inherits-from>Effects/model-transparent</inherits-from>
        <condition>
            <property>sim/rendering/rembrandt/enabled</property>
        </condition>
		 <object-name>blurred1</object-name>
		
	
        <object-name>blade1</object-name>
        <object-name>blade1a</object-name>
        <object-name>blade1b</object-name>
        <object-name>blade1c</object-name>
		 <object-name>blade1d</object-name>
		  <object-name>blade1e</object-name>
	
	
    </effect> 
	
	
	  <animation>
        <type>select</type>
       <object-name>blurred1</object-name>
		
	
        <condition>
            <greater-than>
                <property>rotors/main/rpm</property>
                <value>170</value>
            </greater-than>
        </condition>
    </animation>
	

	 <animation>
        <type>select</type>
        <object-name>blade1</object-name>
        <object-name>blade1a</object-name>
        <object-name>blade1b</object-name>
        <object-name>blade1c</object-name>
		 <object-name>blade1d</object-name>
		  <object-name>blade1e</object-name>
        <condition>
            <less-than>
                <property>rotors/main/rpm</property>
                <value>200</value>
            </less-than>
        </condition>
    </animation>
	
    <animation>
	<type>material</type>
	<object-name>blade1</object-name>
        <object-name>blade1a</object-name>
        <object-name>blade1b</object-name>
        <object-name>blade1c</object-name>
		 <object-name>blade1d</object-name>
		  <object-name>blade1e</object-name>
	
		<global type="bool">true</global>
		<transparency>
			<alpha-prop>rotors/main/rpm</alpha-prop>
			<factor>-0.0045</factor>
			<offset>1</offset>
			<max>1</max>
			
		</transparency>
    </animation>
	
    <animation>
	<type>material</type>
	 <object-name>blurred1</object-name>
		
		
		<transparency>
			<alpha-prop>rotors/main/rpm</alpha-prop>
			<factor>0.016</factor>
			<offset>-0.25</offset>
			<max>0.9</max>
		</transparency>
		<threshold>0.001</threshold>
    </animation>
	

	

    <animation>
        <name>bladecomplete</name>
        <object-name>blade1</object-name>
        <object-name>blade1a</object-name>
        <object-name>blade1b</object-name>
        <object-name>blade1c</object-name>
		 <object-name>blade1d</object-name>
		  <object-name>blade1e</object-name>
		   <object-name>pendulum1</object-name>
		    <object-name>blade_fitting1</object-name>
			 <object-name>blade_mounting_fork1</object-name>
			 <object-name>pitch_horn1</object-name>
			  <object-name>absorber1</object-name>
    </animation>

   

	
    <animation>
        <type>select</type>
       <object-name>blurred1</object-name>
		
	
        <condition>
            <greater-than>
                <property>rotors/main/rpm</property>
                <value>170</value>
            </greater-than>
        </condition>
    </animation>
	

	
	

    <animation>
        <type>rotate</type>
        <object-name>bladecomplete</object-name>
		 
        <property>rotors/main/blade[2]/incidence-deg</property>
	<factor>1</factor>
        <center>
            <x-m>0</x-m>
            <y-m>0</y-m>
           <z-m>1.82</z-m>
        </center>
        <axis>
            <x>1.0</x>
            <y>-0.0</y>
            <z>0.0</z>
        </axis>
    </animation>
	
    <animation>
        <type>rotate</type>
        <object-name>blade1a</object-name>
        <object-name>blade1b</object-name>
        <object-name>blade1c</object-name>
		<object-name>blade1d</object-name>
		<object-name>blade1e</object-name>
        <property>rotors/main/blade[2]/flap-deg</property>
        <factor>0.2</factor>
        <center>
            <x-m>1.0</x-m>
            <y-m>0.075</y-m>
           <z-m>1.82</z-m>
        </center>
        <axis>
            <x>0</x>
            <y>-1.0</y>
            <z>0.0</z>
        </axis>
    </animation>
	
    <animation>
        <type>rotate</type>
        <object-name>blade1b</object-name>
        <object-name>blade1c</object-name>
		<object-name>blade1d</object-name>
		<object-name>blade1e</object-name>
        <property>rotors/main/blade[2]/flap-deg</property>
        <factor>0.25</factor>
        <center>
             <x-m>1.8</x-m>
             <y-m>0.075</y-m>
            <z-m>1.82</z-m>
        </center>
        <axis>
            <x>0</x>
            <y>-1.0</y>
            <z>0.0</z>
        </axis>
    </animation>
	
	<animation>
        <type>rotate</type>
         <object-name>blade1c</object-name>
		<object-name>blade1d</object-name>
		<object-name>blade1e</object-name>
        <property>rotors/main/blade[2]/flap-deg</property>
        <factor>0.3</factor>
        <center>
            <x-m>2.6</x-m>
            <y-m>0.075</y-m>
           <z-m>1.82</z-m>
        </center>
        <axis>
            <x>0</x>
            <y>-1.0</y>
            <z>0.0</z>
        </axis>
    </animation>
	
	<animation>
        <type>rotate</type>
        <object-name>blade1d</object-name>
		<object-name>blade1e</object-name>
        <property>rotors/main/blade[2]/flap-deg</property>
        <factor>0.35</factor>
        <center>
            <x-m>3.3</x-m>
            <y-m>0.075</y-m>
           <z-m>1.82</z-m>
        </center>
        <axis>
            <x>0</x>
            <y>-1.0</y>
            <z>0.0</z>
        </axis>
    </animation>
	
	<animation>
        <type>rotate</type>
       
		<object-name>blade1e</object-name>
        <property>rotors/main/blade[2]/flap-deg</property>
        <factor>0.4</factor>
        <center>
            <x-m>4</x-m>
            <y-m>0.075</y-m>
           <z-m>1.82</z-m>
        </center>
        <axis>
            <x>0</x>
            <y>-1.0</y>
            <z>0.0</z>
        </axis>
    </animation>
	
	


</PropertyList>
