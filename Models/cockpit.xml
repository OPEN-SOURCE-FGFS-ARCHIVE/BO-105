    <dep>.03</dep>
   </entry>
   <entry>
    <ind>1</ind>
    <dep>.03</dep>
   </entry>
  </interpolation>
  <axis>
   <x>0</x>
   <y>-1</y>
   <z>0</z>
  </axis>
 </animation>
 <animation>
  <type>translate</type>
  <object-name>SignL</object-name>
  <property>sim/model/bo105/doors/door[3]/position-norm</property>
  <interpolation>
   <entry>
