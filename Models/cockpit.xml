		<object-name>blah.015</object-name>
		<object-name>SignR</object-name>
		<object-name>SignL</object-name>
	</effect>

  <animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>300</max-m>
    </animation>
 
 <animation>
		<type>material</type>
			<object-name>blah.019</object-name>
			

		<emission>
			<red>0.48</red>
			<green>0.80</green>
			<blue>0.44</blue>
<factor-prop>controls/lighting/instrument-lights-norm</factor-prop>
		</emission>
	</animation> 
 
   <!-- Glass and transparent areas for rembrandt 
    <animation>
        <type>shader</type>
        <shader>chrome</shader>
        <texture>Aircraft/Generic/Effects/glass_shader.png</texture>
       
		<object-name>blah.027</object-name>
    </animation>
-->
    <effect>
        <inherits-from>Effects/model-transparent</inherits-from>
        <condition>
            <property>sim/rendering/rembrandt/enabled</property>
        </condition>
       
        <object-name>blah.027</object-name>
       
    </effect>
	
    
    
    <model>
        <name>overhead1</name>
        <path>Aircraft/BO-105/Models/overhead.xml</path>
        <offsets>
            <x-m>0.0</x-m>
            <y-m>0.0</y-m>
            <z-m>0.0</z-m>
            <pitch-deg>0</pitch-deg>
        </offsets>
    </model>
	
	<model>
        <name>overhead2</name>
        <path>Aircraft/BO-105/Models/power.xml</path>
        <offsets>
            <x-m>0.0</x-m>
            <y-m>0.0</y-m>
            <z-m>0.0</z-m>
            <pitch-deg>0</pitch-deg>
        </offsets>
    </model>
	
 
  <model>
        <name>collective1</name>
        <path>Aircraft/BO-105/Instruments/collective/collective.xml</path>
        <offsets>
            <x-m>-1.45</x-m>
            <y-m>0.09</y-m>
            <z-m>-0.15</z-m>
            <pitch-deg>0</pitch-deg>
        </offsets>
    </model>
	
	
	 <model>
        <name>collective2</name>
        <path>Aircraft/BO-105/Instruments/collective/collective.xml</path>
        <offsets>
            <x-m>-1.45</x-m>
            <y-m>-0.72</y-m>
            <z-m>-0.15</z-m>
            <pitch-deg>0</pitch-deg>
        </offsets>
    </model>
 
 
 	
 
 <animation>
  <type>translate</type>
  <object-name>SignR</object-name>
  <property>sim/model/bo105/doors/door[2]/position-norm</property>
  <interpolation>
   <entry>
    <ind>0</ind>
    <dep>0</dep>
   </entry>
   <entry>
    <ind>.1</ind>
    <dep>.03</dep>
   </entry>
   <entry>
    <ind>1</ind>
    <dep>.03</dep>
   </entry>
  </interpolation>
  <axis>
   <x>0</x>
   <y>1</y>
   <z>0</z>
  </axis>
 </animation>
 <animation>
  <type>translate</type>
  <object-name>SignR</object-name>
  <property>sim/model/bo105/doors/door[2]/position-norm</property>
  <interpolation>
   <entry>
    <ind>0</ind>
    <dep>0</dep>
   </entry>
   <entry>
    <ind>.1</ind>
    <dep>0</dep>
   </entry>
   <entry>
    <ind>1</ind>
    <dep>.6</dep>
