<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

	<path>fflowgauge.ac</path>

	<effect>
		<inherits-from>../../Models/Effects/interior/bo105-interior</inherits-from>
		<object-name>face</object-name>
		<object-name>needle</object-name>
	</effect>

<animation>
  <type>scale</type>
  <x-offset>0.62</x-offset>
  <y-offset>0.62</y-offset>
  <z-offset>0.62</z-offset>
 </animation>  

  <animation>
    <object-name>face</object-name>
    <object-name>needle</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle</object-name>
    <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
			<red>0.48</red>
			<green>0.80</green>
			<blue>0.44</blue>
    </emission>
  </animation>
	
  <animation>
    <type>rotate</type>
    <object-name>needle</object-name>
    <property>/engines/engine[1]/fuel-flow-gph</property>
    <interpolation>
      <entry><ind>   0 </ind><dep>   0 </dep></entry>
      <entry><ind> 119 </ind><dep> 240 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>
 
	<animation>
		<type>range</type>
		<min-m>0</min-m>
		<max-m>5</max-m>
	</animation>   

</PropertyList>
